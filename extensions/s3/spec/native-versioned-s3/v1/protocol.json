{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "prolly-native-versioned-s3/v1",
  "status": "frozen",
  "versions": {
    "repository_format": 1,
    "capability_profile": 1,
    "reader_protocol": 1,
    "writer_protocol": 1,
    "canonical_cbor": 1,
    "hashing": 1,
    "path_layout": 1,
    "state_machines": 1,
    "errors": 1,
    "conformance": 1,
    "semantic_api": 1
  },
  "defaults": {
    "repository_format": 1,
    "capability_profile": 1,
    "reader_protocol": 1,
    "writer_protocol": 1,
    "canonical_cbor": 1,
    "hashing": 1,
    "path_layout": 1,
    "state_machines": 1,
    "errors": 1,
    "conformance": 1,
    "semantic_api": 1,
    "repository_prefix": ".prolly/v1",
    "default_branch": "main"
  },
  "media_type": "application/vnd.prolly.native-s3.v1+cbor",
  "schema": "schema.cddl",
  "api_model": "api.smithy",
  "format_path": "{prefix}/format/v1.cbor",
  "identifier_prefixes": {
    "repository": "pr1_",
    "commit": "pbc1_",
    "object_version": "pov1_",
    "reflog": "prl1_",
    "tree_format": "ptf1_",
    "provider_profile": "ppf1_",
    "gc_plan": "pgc1_",
    "node_pack": "pnp1_",
    "node_index_checkpoint": "nic1_",
    "operation": "op1_",
    "batch": "pb1_"
  },
  "persisted_records": [
    "RepositoryFormatV1",
    "InitializationIntentV1",
    "ProviderAttestationV1",
    "ObjectVersionV1",
    "CurrentObjectV1",
    "OperationRecordV1",
    "BucketDeltaV1",
    "CommitObjectV1-framed",
    "NodePackV1-framed",
    "NodePackTocV1",
    "NodeIndexCheckpointV1",
    "NodeIndexHeadV1",
    "BucketCommitV1",
    "GcPlanV1",
    "GcMarkRunV1",
    "GcRunV1",
    "RetentionPinV1",
    "ReflogEntryV1",
    "RefValueV1",
    "ExclusiveWriterLeaseV1",
    "TagValueV1",
    "NativeMultipartSessionV1",
    "NativePreparedMutationV1",
    "NativeBatchMutationV1",
    "NativeBatchV1"
  ],
  "path_record_dispatch": {
    "format/v1.cbor": "RepositoryFormatV1",
    "format/initialization.cbor": "InitializationIntentV1",
    "providers/*.cbor": "ProviderAttestationV1",
    "writers/lease.cbor": "ExclusiveWriterLeaseV1",
    "refs/heads/*": "RefValueV1",
    "refs/tags/*": "TagValueV1",
    "reflogs/tags/*/*": "ReflogEntryV1",
    "commits/sha256/*/*/*": "CommitObjectV1-framed",
    "node-index/checkpoints/*.cbor": "NodeIndexCheckpointV1",
    "node-index/latest.cbor": "NodeIndexHeadV1",
    "retention/pins/*": "RetentionPinV1",
    "gc/plans/*.cbor": "GcPlanV1",
    "gc/runs/*.cbor": "GcRunV1",
    "gc/mark-runs/*.cbor": "GcMarkRunV1"
  },
  "tree_value_dispatch": {
    "objects": "CurrentObjectV1",
    "versions": "ObjectVersionV1",
    "operations": "OperationRecordV1"
  }
}
