PROLLY_RUSTFS_DATA_DIR=/Volumes/Workspace/prolly-data
PROLLY_RUSTFS_API_PORT=9000
PROLLY_RUSTFS_CONSOLE_PORT=9001
PROLLY_S3_RUSTFS=1
PROLLY_RUSTFS_ENDPOINT=http://127.0.0.1:9000
PROLLY_RUSTFS_BUCKET=prolly-versioned-s3-tests
PROLLY_RUSTFS_ACCESS_KEY=prollyadmin
PROLLY_RUSTFS_SECRET_KEY=prolly-local-secret-change-me
PROLLY_RUSTFS_RPC_SECRET=prolly-local-rpc-secret-change-me
PROLLY_RUSTFS_LOG_LEVEL=info
# Opt in only for explicit qualification runs.
PROLLY_S3_BENCHMARK=0
PROLLY_S3_RESOURCE_TEST=0

# Opt-in real AWS qualification. Credentials come from the ordinary AWS SDK
# default chain; these buckets must be isolated and have no conflicting
# lifecycle rule or default Object Lock retention.
PROLLY_S3_AWS=0
PROLLY_AWS_REGION=us-west-2
PROLLY_AWS_BUCKET_UNVERSIONED=
PROLLY_AWS_BUCKET_VERSIONED=
# Optional comma-separated real directory/access-point/Object-Lambda/
# Outposts/MRAP identifiers that must fail before any probe write.
PROLLY_AWS_REJECT_IDENTIFIERS=
